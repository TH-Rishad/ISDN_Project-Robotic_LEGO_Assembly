# Python bytecode / build caches (never upload these)
__pycache__/
*.py[cod]

# Local Codex build artifacts
.codex-build/

# macOS Finder metadata
.DS_Store

# LaTeX build leftovers (regenerated by pdflatex)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex
*.synctex.gz

# Stills generated by the final report's reproduction example
/final_report/stills/

# IDE
.idea/

# Per-member identity marker and personal agent instructions:
# machine-local, not part of the shared repo
Kean/kean.id
Kean/AGENTS.md
Kean/.cursor/
Kean/config/

# Kean run artifacts. JSON evidence stays; recorder dumps do not.
Kean/results/**/*.npz

# Remote scratch dirs on a shared checkout. Not part of the shared repo.
/runs/
/transfer-tests/
