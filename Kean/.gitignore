# Personal ignores for Kean's workspace

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/
venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Temporary / build. Archived check logs stay under results/archive/checks/.
*.tmp
*.log
!results/archive/checks/**/*.log
!results/checks/**/*.log
*.bak
build/
dist/

# Recorder dumps. JSON summaries stay.
*.npz

# Personal scratch only (not assignment docs). Work trajectory Markdown —
# README.md, work_record.md, review.md, DUAL_BUILDER_PLAN.md,
# results/**/*.md — stays tracked for submission.
notes/
scratch/
*.md.bak
todo-personal.md

# Identity and local tooling. Do not push. kean.id is ignored at the
# repository root .gitignore.
AGENTS.md
.cursor/
config/

# Submission videos (recordings stay ignored)
!*.mp4
!results/**/*.mp4
